[TEMPLATE]
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored -- never commit real secrets.
# ---------------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (Vite dev server default)
CORS_ORIGIN=http://localhost:5173

# --- MySQL (Phase 2 + 3) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=smart_food_inventory

# --- Auth / JWT (Phase 4) ---
# Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Daily expiry sweep (Phase 7) ---
# Set to false to stop the in-process cron job (e.g. when the OS scheduler runs
# `npm run sweep` instead).
EXPIRY_SWEEP_ENABLED=true
# Standard 5-field cron. Default: every day at 08:00.
EXPIRY_SWEEP_CRON=0 8 * * *
# Must match the timezone MySQL uses, or the sweep fires on a different
# calendar day than the one CURDATE() reports.
EXPIRY_SWEEP_TZ=Asia/Kolkata
# Also run once ~2s after boot, to cover "the server was off at 08:00".
# Harmless: the sweep is idempotent.
EXPIRY_SWEEP_ON_BOOT=true
# How many days past expiry to keep reminding, so an item the user never
# deleted does not raise an alert every day forever.
EXPIRY_ALERT_GRACE_DAYS=7

# --- Meta WhatsApp Cloud API (Phase 8) ---
# Leave all three blank to run in DRY RUN: every message is printed to the server
# log instead of being sent, so the whole alert pipeline works without an account.
#
# Get these from https://developers.facebook.com -> Meta for Developers ->
# My Apps -> your app -> WhatsApp -> Getting Started panel
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Pinned API version -- Meta ships breaking changes per version, so a silent
# upgrade is not something a daily cron job should discover on its own.
WHATSAPP_API_VERSION=v21.0
# Message template registered in the Meta dashboard (WhatsApp > Message Templates).
# Required for scheduled sends outside the 24-hour re-engagement window.
# The template must have exactly one body parameter ({{1}}) for the message text.
# Leave empty to use free-form text only (works within 24h of the user's last message).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Set true to keep simulating even once the credentials above are filled in --
# useful while testing so no real messages go out.
WHATSAPP_DRY_RUN=false

# --- WhatsApp dispatch worker (Phase 8) ---
# Set false to stop the in-process sender (e.g. when the OS scheduler runs
# `npm run dispatch` instead).
WHATSAPP_DISPATCH_ENABLED=true
# Default 08:05 -- five minutes after the sweep, so it drains a full queue.
WHATSAPP_DISPATCH_CRON=5 8 * * *
WHATSAPP_DISPATCH_TZ=Asia/Kolkata
# Users per run. The Cloud API free tier is rate limited, so keep this modest.
WHATSAPP_BATCH_SIZE=20
# Pause between messages, so a batch does not arrive as one burst.
WHATSAPP_PAUSE_MS=400
# Retries for a *transient* failure (Meta 5xx, rate limit, no network). A
# permanent one (bad number, opted out, outside 24h window) is never retried.
WHATSAPP_MAX_ATTEMPTS=3
# How long an undelivered alert is still worth sending. "Expires tomorrow"
# delivered four days late is not late, it is wrong.
WHATSAPP_STALE_AFTER_DAYS=2

# --- Recipe API (Phase 9) ---
# Spoonacular: https://spoonacular.com/food-api  (free tier: 150 req/day)
SPOONACULAR_API_KEY=

# --- ESP32-CAM (Phase 10) ---
# Shared secret the device sends in the `x-device-key` header when uploading.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_API_KEY=
# Whose kitchen the camera photographs (the users.id it files photos under).
# Leave empty to disable device uploads entirely (they answer 503).
DEVICE_USER_ID=
# Where photos are stored, relative to backend/. Git-ignored.
DEVICE_UPLOAD_DIR=uploads/detections
# Reject a capture larger than this (the ESP32 sends ~60-150 KB VGA JPEGs).
DEVICE_MAX_IMAGE_BYTES=2097152

# --- Food recognition from photos (Phase 10) ---
# Google AI Studio: https://aistudio.google.com/apikey (free tier).
# Leave empty and uploads still work -- the model just proposes nothing and
# the review screen shows a blank form beside the photo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
