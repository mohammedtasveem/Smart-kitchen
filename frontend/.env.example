# Where the backend API lives.
#
# Leave this unset (or as-is) for local development: the Vite dev server proxies
# /api to http://localhost:5000, so the browser stays on one origin and CORS
# never comes into play. See vite.config.js.
#
# For a deployed build, point it at the real API, e.g.
#   VITE_API_BASE=https://api.yourdomain.com/api
#
# NOTE: every VITE_* variable is inlined into the JavaScript bundle and is
# therefore PUBLIC. Never put a secret, password or API key in this file.
VITE_API_BASE=/api
